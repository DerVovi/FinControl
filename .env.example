# FinControl — Variáveis de Ambiente para Produção / Docker
NODE_ENV=production
PORT=3333
FRONTEND_PORT=80
CLIENT_URL=http://localhost:80

# Banco de Dados SQLite (Persistido no volume docker /app/prisma/data/)
DATABASE_URL="file:/app/prisma/data/fincontrol.db"

# Chaves Criptográficas (Gere sequências aleatórias seguras com openssl rand -base64 32)
JWT_SECRET=coloque_aqui_uma_chave_secreta_com_no_minimo_32_caracteres_aleatorios
JWT_REFRESH_SECRET=coloque_aqui_outra_chave_secreta_com_no_minimo_32_caracteres_aleatorios
